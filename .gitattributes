# Normalize line endings across platforms. Text is stored LF in the repo and in
# working trees, so the skill scripts and shell hooks stay consistent on Windows,
# macOS, and Linux.
* text=auto eol=lf

# Shell hooks and Python must be LF to run.
*.sh text eol=lf
*.py text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.pdf binary

# Author-class files (see .kb-manifest.json) belong to the template source only.
# export-ignore keeps them out of `git archive`, GitHub "Download ZIP" and release
# archives. In a knowledge base these lines only matter if you publish it with
# `git archive` yourself.
/openspec export-ignore
/dev export-ignore
/CONTRIBUTING.md export-ignore
/CLAUDE.local.md export-ignore
